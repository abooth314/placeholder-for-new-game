include(FetchContent)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/dependencies.lock.json" lock)
string(JSON count LENGTH "${lock}" dependencies)
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
  foreach(key name archive url sha256)
    string(JSON ${key} GET "${lock}" dependencies ${i} ${key})
  endforeach()
  if(EXISTS "${CMAKE_SOURCE_DIR}/.dependencies/downloads/${archive}")
    set(url "${CMAKE_SOURCE_DIR}/.dependencies/downloads/${archive}")
  endif()
  if(name STREQUAL "lua" OR name STREQUAL "imgui")
    FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${sha256}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE SOURCE_SUBDIR _populate_only)
  else()
    FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${sha256}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  endif()
endforeach()
set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
set(JSON_Install OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(json lua)
set(lua_units lapi lcode lctype ldebug ldo ldump lfunc lgc llex lmem lobject lopcodes lparser lstate lstring ltable ltm lundump lvm lzio lauxlib lbaselib ltablib lstrlib lmathlib lutf8lib)
set(lua_files)
foreach(unit IN LISTS lua_units)
  list(APPEND lua_files "${lua_SOURCE_DIR}/src/${unit}.c")
endforeach()
add_library(curved_lua STATIC ${lua_files})
target_include_directories(curved_lua PUBLIC "${lua_SOURCE_DIR}/src")
if(UNIX)
  target_link_libraries(curved_lua PUBLIC m)
endif()
if(CURVED_BUILD_CLIENT)
  set(SDL_SHARED OFF CACHE BOOL "" FORCE)
  set(SDL_STATIC ON CACHE BOOL "" FORCE)
  set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
  FetchContent_MakeAvailable(sdl imgui)
  add_library(curved_imgui STATIC
    "${imgui_SOURCE_DIR}/imgui.cpp" "${imgui_SOURCE_DIR}/imgui_draw.cpp"
    "${imgui_SOURCE_DIR}/imgui_tables.cpp" "${imgui_SOURCE_DIR}/imgui_widgets.cpp"
    "${imgui_SOURCE_DIR}/backends/imgui_impl_sdl3.cpp"
    "${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp")
  target_include_directories(curved_imgui PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends")
  target_link_libraries(curved_imgui PUBLIC SDL3::SDL3-static)
  install(FILES "${sdl_SOURCE_DIR}/LICENSE.txt" DESTINATION notices RENAME SDL3-LICENSE.txt)
  install(FILES "${imgui_SOURCE_DIR}/LICENSE.txt" DESTINATION notices RENAME IMGUI-LICENSE.txt)
  install(FILES "${imgui_SOURCE_DIR}/imstb_rectpack.h" "${imgui_SOURCE_DIR}/imstb_truetype.h" "${imgui_SOURCE_DIR}/imstb_textedit.h" DESTINATION notices/stb)
endif()
install(FILES "${json_SOURCE_DIR}/LICENSE.MIT" DESTINATION notices RENAME JSON-LICENSE.txt)
install(FILES "${lua_SOURCE_DIR}/doc/readme.html" DESTINATION notices RENAME LUA-README.html)
